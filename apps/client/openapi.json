  "components": {
    "schemas": {
      "ChildCreateRequest": {
        "properties": {
          "nickname": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Nickname"
          },
          "birth_year": {
            "type": "integer",
            "maximum": 2100.0,
            "minimum": 1900.0,
            "title": "Birth Year"
          },
          "grade": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Grade"
          },
          "purposes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Purposes"
          }
        },
        "type": "object",
        "required": [
          "nickname",
          "birth_year",
          "grade"
        ],
        "title": "ChildCreateRequest"
      },
      "ChildPairRequest": {
        "properties": {
          "child_id": {
            "type": "string",
            "format": "uuid",
            "title": "Child Id"
          },
          "code": {
            "type": "string",
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "child_id",
          "code"
        ],
        "title": "ChildPairRequest"
      },
      "ChildPatchRequest": {
        "properties": {
          "nickname": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Nickname"
          },
          "daily_new_problem_limit": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Daily New Problem Limit"
          },
          "solution_policy": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "never",
                  "after_attempts_with_notice",
                  "guardian_only",
                  "similar_example_only"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Solution Policy"
          },
          "privacy_level": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "summary_only",
                  "full_transcript"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Privacy Level"
          }
        },
        "type": "object",
        "title": "ChildPatchRequest"
      },
      "ChildProfileResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "nickname": {
            "type": "string",
            "title": "Nickname"
          },
          "birth_year": {
            "type": "integer",
            "title": "Birth Year"
          },
          "grade": {
            "type": "integer",
            "title": "Grade"
          },
          "age_band": {
            "type": "string",
            "title": "Age Band"
          },
          "daily_new_problem_limit": {
            "type": "integer",
            "title": "Daily New Problem Limit"
          },
          "solution_policy": {
            "type": "string",
            "title": "Solution Policy"
          },
          "privacy_level": {
            "type": "string",
            "title": "Privacy Level"
          }
        },
        "type": "object",
        "required": [
          "id",
          "nickname",
          "birth_year",
          "grade",
          "age_band",
          "daily_new_problem_limit",
          "solution_policy",
          "privacy_level"
        ],
        "title": "ChildProfileResponse"
      },
      "ChildTokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          }
        },
        "type": "object",
        "required": [
          "access_token"
        ],
        "title": "ChildTokenResponse"
      },
      "ConsentRequest": {
        "properties": {
          "purposes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Purposes"
          },
          "grant": {
            "type": "boolean",
            "title": "Grant"
          }
        },
        "type": "object",
        "required": [
          "purposes",
          "grant"
        ],
        "title": "ConsentRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "LogoutRequest": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          }
        },
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "LogoutRequest"
      },
      "PairingCodeResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "code",
          "expires_at"
        ],
        "title": "PairingCodeResponse"
      },
      "RefreshRequest": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          }
        },
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "RefreshRequest"
      },
      "RegisterRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          },
          "role": {
            "type": "string",
            "enum": [
              "guardian",
              "teacher"
            ],
            "title": "Role"
          },
          "full_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Full Name"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password",
          "role"
        ],
        "title": "RegisterRequest"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "refresh_token"
        ],
        "title": "TokenResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
