# apps/api için yerel geliştirme ortam değişkeni şablonu.
# Bu dosyayı .env olarak kopyalayıp değerleri düzenleyin.
HINT_ENVIRONMENT=local
# Docker Compose: @db:5432 · Docker'sız (scripts/localdb.py): @127.0.0.1:5432
HINT_DATABASE_URL=postgresql://hint:hint@db:5432/hint
HINT_ASYNC_DATABASE_URL=postgresql+asyncpg://hint:hint@db:5432/hint
# Boş bırakılırsa Redis kontrolü atlanır (şu an yalnızca /readyz kullanıyor).
HINT_REDIS_URL=redis://redis:6379/0
HINT_JWT_SECRET=dev-secret-change-me-0123456789abcdef

# LLM Gateway
# mock: testler · demo: kotasız yerel sahte model (basit soruları SymPy ile çözer, şablon ipucu)
# gemini/openai/http: gerçek model (LLM_API_KEY gerekir; anahtar repoya girmez)
LLM_PROVIDER=mock
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.6-flash
LLM_API_KEY=
# Her ipucu = ipucu + yargıç çağrısı; yerel demoda daha yüksek tutulabilir.
LLM_DAILY_CALL_LIMIT_PER_CHILD=50
# Kural kontrolünü geçen her ipucu ayrıca LLM yargıca sorulur (fail-closed).
HINT_LEAK_JUDGE_ENABLED=true

# Expo web istemcisinin API çağırabileceği origin listesi (JSON)
HINT_CORS_ORIGINS=["http://localhost:8081"]

# YALNIZCA YEREL DENEME: giriş ekranındaki "Demo çocuk/ebeveyn/öğretmen olarak gir" düğmeleri.
# Kimlik doğrulamasını atlar; canlı ortamda ASLA true yapmayın.
HINT_DEV_SHORTCUTS=false
