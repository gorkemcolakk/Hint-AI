# apps/api için yerel geliştirme ortam değişkeni şablonu.
# Bu dosyayı .env olarak kopyalayıp değerleri düzenleyin.
HINT_ENVIRONMENT=local
HINT_DATABASE_URL=postgresql://hint:hint@db:5432/hint
HINT_ASYNC_DATABASE_URL=postgresql+asyncpg://hint:hint@db:5432/hint
HINT_REDIS_URL=redis://redis:6379/0
HINT_JWT_SECRET=dev-secret-change-me-0123456789abcdef

# LLM Gateway
LLM_PROVIDER=mock
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
